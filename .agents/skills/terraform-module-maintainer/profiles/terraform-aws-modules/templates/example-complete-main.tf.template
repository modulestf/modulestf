locals {
  name = "complete-${basename(path.cwd)}"

  tags = {
    Example     = local.name
    Environment = "dev"
    Terraform   = "true"
  }
}

################################################################################
# {{MODULE_NAME}} Module - Complete
################################################################################

module "{{module_name}}" {
  source = "../.."

  name = local.name

  # Populate with real module variables from the coverage matrix.
  # Demonstrate all major features - not placeholder feature flags.

  tags = local.tags
}

################################################################################
# {{MODULE_NAME}} Module - Disabled
################################################################################

module "disabled" {
  source = "../.."

  create = false

  # Provide required variables to verify create=false works
  name = "disabled-${local.name}"
}

