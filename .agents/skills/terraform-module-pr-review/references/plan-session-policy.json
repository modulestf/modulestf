{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadConfiguration",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:Describe*",
        "iam:Get*", "iam:List*",
        "s3:GetBucket*", "s3:GetEncryptionConfiguration", "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration", "s3:GetAccelerateConfiguration",
        "s3:ListAllMyBuckets", "s3:ListBucket",
        "kms:Describe*", "kms:List*", "kms:GetKeyPolicy", "kms:GetKeyRotationStatus",
        "logs:Describe*", "logs:ListTagsForResource",
        "ssm:Describe*", "ssm:ListTagsForResource",
        "lambda:GetPolicy", "lambda:List*",
        "dynamodb:Describe*", "dynamodb:ListTables", "dynamodb:ListTagsOfResource",
        "sqs:GetQueueAttributes", "sqs:GetQueueUrl", "sqs:ListQueues", "sqs:ListQueueTags",
        "sns:GetTopicAttributes", "sns:ListTopics", "sns:ListTagsForResource",
        "elasticloadbalancing:Describe*", "autoscaling:Describe*",
        "rds:Describe*", "rds:ListTagsForResource",
        "ecs:Describe*", "ecs:List*", "ecr:Describe*", "ecr:ListTagsForResource",
        "eks:Describe*", "eks:List*",
        "cloudwatch:Describe*", "cloudwatch:ListTagsForResource",
        "events:Describe*", "events:List*",
        "secretsmanager:DescribeSecret", "secretsmanager:ListSecrets",
        "acm:Describe*", "acm:List*",
        "route53:Get*", "route53:List*",
        "cloudfront:Get*", "cloudfront:List*",
        "elasticfilesystem:Describe*",
        "backup:Describe*", "backup:List*",
        "organizations:Describe*", "organizations:List*",
        "kinesis:Describe*", "kinesis:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoDataReads",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject*", "secretsmanager:GetSecretValue", "ssm:GetParameter*",
        "kms:Decrypt", "kms:GenerateDataKey*", "lambda:GetFunction",
        "logs:GetLogEvents", "logs:FilterLogEvents", "kinesis:GetRecords",
        "dynamodb:GetItem", "dynamodb:Query", "dynamodb:Scan", "sqs:ReceiveMessage",
        "ecr:GetAuthorizationToken", "ecr:GetDownloadUrlForLayer",
        "lambda:GetFunctionConfiguration", "ecs:DescribeTaskDefinition",
        "ec2:DescribeLaunchTemplateVersions", "ec2:DescribeInstanceAttribute",
        "cloudfront:GetFunction", "iam:GetAccountAuthorizationDetails",
        "lambda:ListFunctions", "lambda:ListVersionsByFunction"
      ],
      "Resource": "*"
    }
  ]
}
