# Runner image for the isolated plan pass. See README.md in this directory.
# The base is pinned by digest. Tool archives are pinned by version and SHA-256.
# Direct Debian package versions were checked against signed apt metadata for amd64
# and arm64 on 2026-10-04. Dependencies still follow the archive; see README.md.
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

ARG TARGETARCH
ARG TERRAFORM_VERSION=1.16.4
# From terraform_1.16.4_SHA256SUMS on releases.hashicorp.com, read 2026-09-24.
ARG TERRAFORM_SHA256_amd64=dc94af0eef1147718ad7c8daea792ed199e3e0492eec180d0adafa2a65a879df
ARG TERRAFORM_SHA256_arm64=8263f301cb1a24489a4adeed147bf28504053f77237b3ea97a0ef2972659de30
ARG AWSCLI_VERSION=2.37.1
# SHA-256 of awscli-exe-linux-<arch>-2.37.1.zip downloaded from awscli.amazonaws.com on
# 2026-09-24. AWS publishes a PGP signature for these files, not a checksum; see README.md.
ARG AWSCLI_SHA256_amd64=61a79950dfb436985611a258d3a8f85a47e13498fcc72c7d8d0597f5c9fde133
ARG AWSCLI_SHA256_arm64=30642dc4840012614229feb68314637d024500f565d92f513a422bdd55844a90

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash=5.2.15-2+b13 \
      ca-certificates=20250419~deb12u1 \
      curl=7.88.1-10+deb12u15 \
      git=1:2.39.5-0+deb12u3 \
      jq=1.6-2.1+deb12u2 \
      perl=5.36.0-7+deb12u3 \
      python3=3.11.2-1+b1 \
      unzip=6.0-28+deb12u1 \
 && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) tf_sha="$TERRAFORM_SHA256_amd64"; cli_arch=x86_64; cli_sha="$AWSCLI_SHA256_amd64" ;; \
      arm64) tf_sha="$TERRAFORM_SHA256_arm64"; cli_arch=aarch64; cli_sha="$AWSCLI_SHA256_arm64" ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    curl -fsSLo terraform.zip "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip"; \
    echo "${tf_sha}  terraform.zip" | sha256sum -c -; \
    unzip -q terraform.zip terraform -d /usr/local/bin; \
    curl -fsSLo awscli.zip "https://awscli.amazonaws.com/awscli-exe-linux-${cli_arch}-${AWSCLI_VERSION}.zip"; \
    echo "${cli_sha}  awscli.zip" | sha256sum -c -; \
    unzip -q awscli.zip; \
    ./aws/install -i /usr/local/aws-cli -b /usr/local/bin; \
    rm -rf /tmp/terraform.zip /tmp/awscli.zip /tmp/aws; \
    terraform version; aws --version

# The lambda module's packaging needs the Python version of the function's runtime on PATH.
# python3.12 is the only Python runtime the terraform-aws-lambda examples use (surveyed
# 2026-09-24). From python-build-standalone release 20260901; SHA-256 values from that
# release's SHA256SUMS, read 2026-09-24.
ARG PY312_VERSION=3.12.14
ARG PBS_RELEASE=20260901
ARG PY312_SHA256_amd64=936c246dfdbbfa7cb22dd01814a21f582a892689fae96b06071a5e433baffa22
ARG PY312_SHA256_arm64=b61b856c3e1a4fc65b8f6e6b0495ef975dd0924f90c59f3ea61b38a079173b84
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) arch=x86_64; sha="$PY312_SHA256_amd64" ;; \
      arm64) arch=aarch64; sha="$PY312_SHA256_arm64" ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    curl -fsSLo python.tar.gz "https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_RELEASE}/cpython-${PY312_VERSION}%2B${PBS_RELEASE}-${arch}-unknown-linux-gnu-install_only.tar.gz"; \
    echo "${sha}  python.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/python3.12; \
    tar -xzf python.tar.gz -C /opt/python3.12 --strip-components=1; \
    rm -f python.tar.gz; \
    ln -s /opt/python3.12/bin/python3.12 /usr/local/bin/python3.12; \
    python3.12 --version

RUN useradd --uid 10001 --user-group --home-dir /work --no-create-home runner \
 && mkdir -p /work \
 && chown 10001:10001 /work

COPY entry.sh /usr/local/bin/plan-entry
COPY egress-probe.sh /usr/local/bin/egress-probe
RUN chmod 0555 /usr/local/bin/plan-entry /usr/local/bin/egress-probe

USER 10001:10001
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/plan-entry"]
