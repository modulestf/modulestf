# L3 fixture template of ladder-pass.sh for aws_rds_cluster with hashicorp/aws 6.70.0.
# Each section starts with a line "#-- <name>". "providers" opens main.tf; "subject" is
# subject.tf alone: the resource under test with fixed arguments that match prior.tfstate,
# and the target attribute last, where __ATTR__ = __EXPR__ takes the trigger's expression.
#-- providers
terraform {
  required_providers {
    aws = { source = "registry.terraform.io/hashicorp/aws", version = "6.70.0" }
  }
}

provider "aws" {
  region                      = "us-east-1"
  access_key                  = "ladder-fake-access-key"
  secret_key                  = "ladder-fake-secret-key"
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
  endpoints {
    rds = "http://127.0.0.1:1"
  }
}

#-- subject
resource "aws_rds_cluster" "this" {
  cluster_identifier  = "ladder-l3"
  engine              = "aurora-postgresql"
  master_username     = "ladder"
  skip_final_snapshot = true
  __ATTR__ = __EXPR__
}
